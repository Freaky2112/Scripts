#!/usr/bin/env bash
#
# Author: Freaky
# Contributors: ChatGPT, Claude
#
# Freaky's Scripts Installer
#

set -euo pipefail

IFS=$'\n\t'


# ============================================================
# Configuration
# ============================================================

GITHUB_REPO="Freaky2112/Scripts"
GITHUB_BRANCH="main"

REPO_SUBDIR="Bash"
ALIAS_SUBDIR="Bash/Bashrc"

BIN_DIR="$HOME/.local/bin"
ALIAS_DIR="$HOME/.bash_aliases.d"

TEMP_DIR=""
REPO_DIR=""

SKIP_ALL=false


# ============================================================
# Colors
# ============================================================

if [[ -t 1 ]]; then
    GREEN='\033[0;32m'
    RED='\033[0;31m'
    YELLOW='\033[1;33m'
    BLUE='\033[0;34m'
    CYAN='\033[0;36m'
    NC='\033[0m'
else
    GREEN=''
    RED=''
    YELLOW=''
    BLUE=''
    CYAN=''
    NC=''
fi


# ============================================================
# Cleanup
# ============================================================

cleanup() {

    if [[ -n "${TEMP_DIR:-}" && -d "$TEMP_DIR" ]]; then
        rm -rf "$TEMP_DIR"
    fi
}

trap cleanup EXIT


# ============================================================
# Pause
# ============================================================

pause() {

    echo

    if [[ -r /dev/tty ]]; then
        read -rp "Press ENTER to continue..." </dev/tty
    fi

    echo
}


# ============================================================
# Banner
# ============================================================

banner() {

    echo
    echo "=========================================="
    echo "       ⚡ Freaky's Scripts"
    echo "=========================================="
    echo
}


# ============================================================
# Input
#
# /dev/tty is used so that interactive prompts work with:
#
# curl ... | bash
#
# ============================================================

ask() {

    local message="$1"

    if [[ ! -r /dev/tty ]]; then

        echo
        echo -e "${RED}No interactive terminal detected.${NC}"
        echo

        exit 1
    fi

    read -rp "$message" REPLY </dev/tty
}


# ============================================================
# Usage
# ============================================================

usage() {

    cat <<EOF

⚡ Freaky's Scripts Installer

Usage:

  $0 [option]

Options:

  -a, --all
      Install all scripts and aliases.

  -s, --scripts
      Install selected Bash scripts.

  -A, --aliases
      Install selected alias categories.

  -u, --uninstall
      Remove scripts installed in ~/.local/bin.

  -h, --help
      Show this help.

Examples:

  ./install

  ./install --all

  ./install --scripts

  ./install --aliases

  curl -fsSL https://raw.githubusercontent.com/$GITHUB_REPO/$GITHUB_BRANCH/Bash/install | bash

  curl -fsSL https://raw.githubusercontent.com/$GITHUB_REPO/$GITHUB_BRANCH/Bash/install | bash -s -- --all

EOF
}


# ============================================================
# Requirements
# ============================================================

check_requirements() {

    local missing=()

    command -v curl >/dev/null 2>&1 || missing+=("curl")
    command -v tar >/dev/null 2>&1 || missing+=("tar")

    if (( ${#missing[@]} > 0 )); then

        echo
        echo -e "${RED}Missing required commands:${NC}"

        printf '  %s\n' "${missing[@]}"

        echo
        echo "Please install them and run the installer again."
        echo

        exit 1
    fi
}


# ============================================================
# Download repository
# ============================================================

download_repository() {

    banner

    echo "Downloading repository..."
    echo
    echo "https://github.com/$GITHUB_REPO"
    echo

    TEMP_DIR="$(mktemp -d)"

    local archive="$TEMP_DIR/repository.tar.gz"

    curl -fsSL \
        "https://github.com/$GITHUB_REPO/archive/refs/heads/$GITHUB_BRANCH.tar.gz" \
        -o "$archive"

    tar -xzf "$archive" -C "$TEMP_DIR"

    REPO_DIR="$(
        find "$TEMP_DIR" \
            -mindepth 1 \
            -maxdepth 1 \
            -type d \
            -name 'Scripts-*' |
        head -n1
    )"

    if [[ -z "$REPO_DIR" || ! -d "$REPO_DIR" ]]; then

        echo -e "${RED}Could not locate downloaded repository.${NC}"

        exit 1
    fi

    if [[ ! -d "$REPO_DIR/$REPO_SUBDIR" ]]; then

        echo -e "${RED}Could not find Bash directory:${NC}"
        echo "$REPO_DIR/$REPO_SUBDIR"

        exit 1
    fi

    echo -e "${GREEN}✓ Repository downloaded${NC}"
    echo
}


# ============================================================
# Prepare directories
# ============================================================

prepare_directories() {

    mkdir -p "$BIN_DIR"
    mkdir -p "$ALIAS_DIR"
}


# ============================================================
# PATH
# ============================================================

ensure_path() {

    local profile="$HOME/.profile"

    touch "$profile"

    if ! grep -Fq "$BIN_DIR" "$profile"; then

        cat >> "$profile" <<EOF

# Added by Freaky's Scripts installer
export PATH="$BIN_DIR:\$PATH"
EOF

        echo -e "${GREEN}✓ Added $BIN_DIR to PATH${NC}"
    fi
}


# ============================================================
# Bash alias loader
# ============================================================

ensure_alias_loader() {

    local bashrc="$HOME/.bashrc"

    touch "$bashrc"

    if grep -Fq "Freaky's Scripts - Bash Aliases" "$bashrc"; then
        return
    fi

    cat >> "$bashrc" <<'EOF'

# ============================================================
# Freaky's Scripts - Bash Aliases
# ============================================================

if [[ -d "$HOME/.bash_aliases.d" ]]; then
    for alias_file in "$HOME/.bash_aliases.d"/*.bash; do
        [[ -r "$alias_file" ]] && source "$alias_file"
    done
fi

EOF

    echo -e "${GREEN}✓ Added alias loader to ~/.bashrc${NC}"
}


# ============================================================
# Discover scripts
# ============================================================

find_scripts() {

    find "$REPO_DIR/$REPO_SUBDIR" \
        -type f \
        ! -path "$REPO_DIR/$ALIAS_SUBDIR/*" \
        ! -name "README*" \
        ! -name "LICENSE*" \
        ! -name "install" \
        ! -name "install.sh" \
        ! -name "uninstall" \
        ! -name "uninstall.sh" \
        \( \
            -name "*.sh" \
            -o -perm -111 \
            -o -exec grep -Iq '^#!' {} \; \
        \) \
        -print |
    sort
}


# ============================================================
# Discover alias categories
# ============================================================

find_aliases() {

    local dir="$REPO_DIR/$ALIAS_SUBDIR"

    [[ -d "$dir" ]] || return 0

    find "$dir" \
        -maxdepth 1 \
        -type f \
        \( \
            -name "*.bash" \
            -o -name "*.sh" \
        \) \
        -print |
    sort
}


# ============================================================
# Overwrite prompt
# ============================================================

should_overwrite() {

    local destination="$1"

    if [[ ! -e "$destination" ]]; then
        return 0
    fi

    while true; do

        ask "$destination exists. Overwrite? [y/n/a] "

        case "$REPLY" in

            y|Y)
                return 0
                ;;

            n|N)
                return 1
                ;;

            a|A)
                SKIP_ALL=true
                return 1
                ;;

            *)
                echo "Please enter y, n or a."
                ;;

        esac

    done
}


# ============================================================
# Install script
# ============================================================

install_script() {

    local source="$1"
    local name
    local destination

    name="$(basename "$source")"
    destination="$BIN_DIR/$name"

    if [[ "$SKIP_ALL" == true ]]; then
        echo "  Skipped: $name"
        return
    fi

    if ! should_overwrite "$destination"; then

        echo -e "  ${YELLOW}Skipped:${NC} $name"

        return
    fi

    cp -p "$source" "$destination"
    chmod +x "$destination"

    echo -e "  ${GREEN}✓ Installed:${NC} $name"
}


# ============================================================
# Alias dependency map
# ============================================================

declare -A ALIAS_DEPENDENCY

# Tools
ALIAS_DEPENDENCY["cat"]="batcat"
ALIAS_DEPENDENCY["wt"]="curl"
ALIAS_DEPENDENCY["speed"]="curl python3"

# Network
ALIAS_DEPENDENCY["lip"]="hostname"
ALIAS_DEPENDENCY["wip"]="curl"
ALIAS_DEPENDENCY["ports"]="ss"
ALIAS_DEPENDENCY["conns"]="ss"
ALIAS_DEPENDENCY["openports"]="ss"
ALIAS_DEPENDENCY["established"]="ss"
ALIAS_DEPENDENCY["pingg"]="ping"
ALIAS_DEPENDENCY["pingc"]="ping"
ALIAS_DEPENDENCY["ipa"]="ip"
ALIAS_DEPENDENCY["route"]="ip"
ALIAS_DEPENDENCY["dns"]="dig"
ALIAS_DEPENDENCY["digg"]="dig"
ALIAS_DEPENDENCY["headers"]="curl"
ALIAS_DEPENDENCY["trace"]="traceroute"

# System
ALIAS_DEPENDENCY["top"]="htop"
ALIAS_DEPENDENCY["pci"]="lspci"
ALIAS_DEPENDENCY["usb"]="lsusb"

# Storage
ALIAS_DEPENDENCY["df"]="df"
ALIAS_DEPENDENCY["disk"]="df"
ALIAS_DEPENDENCY["disks"]="lsblk"
ALIAS_DEPENDENCY["du"]="du"
ALIAS_DEPENDENCY["bigfiles"]="du"
ALIAS_DEPENDENCY["mounts"]="mount column"

# SSH
ALIAS_DEPENDENCY["sshlist"]="ssh-add"
ALIAS_DEPENDENCY["ssha"]="ssh-agent ssh-add"
ALIAS_DEPENDENCY["sshconfig"]="nano"

# APT
ALIAS_DEPENDENCY["apt"]="apt"
ALIAS_DEPENDENCY["update"]="apt"
ALIAS_DEPENDENCY["install"]="apt"
ALIAS_DEPENDENCY["aptsearch"]="apt"
ALIAS_DEPENDENCY["clean"]="apt"

# Systemd
ALIAS_DEPENDENCY["services"]="systemctl"
ALIAS_DEPENDENCY["failed"]="systemctl"
ALIAS_DEPENDENCY["sstatus"]="systemctl"
ALIAS_DEPENDENCY["srestart"]="systemctl"
ALIAS_DEPENDENCY["sstart"]="systemctl"
ALIAS_DEPENDENCY["sstop"]="systemctl"
ALIAS_DEPENDENCY["senable"]="systemctl"
ALIAS_DEPENDENCY["sdisable"]="systemctl"

# Logs
ALIAS_DEPENDENCY["logs"]="journalctl"
ALIAS_DEPENDENCY["sjournal"]="journalctl"
ALIAS_DEPENDENCY["todaylogs"]="journalctl"
ALIAS_DEPENDENCY["bootlogs"]="journalctl"
ALIAS_DEPENDENCY["klogs"]="journalctl"
ALIAS_DEPENDENCY["errors"]="journalctl"

# Docker
ALIAS_DEPENDENCY["dps"]="docker"
ALIAS_DEPENDENCY["dpsa"]="docker"
ALIAS_DEPENDENCY["dimg"]="docker"
ALIAS_DEPENDENCY["dlog"]="docker"
ALIAS_DEPENDENCY["dstats"]="docker"
ALIAS_DEPENDENCY["dtop"]="docker"
ALIAS_DEPENDENCY["dstart"]="docker"
ALIAS_DEPENDENCY["dstop"]="docker"
ALIAS_DEPENDENCY["drestart"]="docker"
ALIAS_DEPENDENCY["drm"]="docker"
ALIAS_DEPENDENCY["dockerdu"]="docker"
ALIAS_DEPENDENCY["dclean"]="docker"

# Docker Compose
ALIAS_DEPENDENCY["dcup"]="docker compose"
ALIAS_DEPENDENCY["dcdown"]="docker compose"
ALIAS_DEPENDENCY["dcrestart"]="docker compose"
ALIAS_DEPENDENCY["dcps"]="docker compose"
ALIAS_DEPENDENCY["dclog"]="docker compose"
ALIAS_DEPENDENCY["dcpull"]="docker compose"
ALIAS_DEPENDENCY["dcupdate"]="docker compose"
ALIAS_DEPENDENCY["dcrebuild"]="docker compose"

# Alias editor
ALIAS_DEPENDENCY["aliases"]="nano"


# ============================================================
# Check dependency
# ============================================================

has_dependency() {

    local dependency="$1"

    # Docker Compose
    if [[ "$dependency" == "docker compose" ]]; then

        command -v docker >/dev/null 2>&1 &&
        docker compose version >/dev/null 2>&1

        return
    fi

    command -v "$dependency" >/dev/null 2>&1
}


# ============================================================
# Check alias dependencies
# ============================================================

alias_has_dependencies() {

    local alias_name="$1"
    local dependencies

    # Alias has no dependency requirement
    if [[ -z "${ALIAS_DEPENDENCY[$alias_name]+exists}" ]]; then
        return 0
    fi

    dependencies="${ALIAS_DEPENDENCY[$alias_name]}"

    local dependency

    # Use spaces for dependency splitting
    local old_ifs="$IFS"
    IFS=' '

    for dependency in $dependencies; do

        if ! has_dependency "$dependency"; then

            IFS="$old_ifs"
            return 1
        fi

    done

    IFS="$old_ifs"

    return 0
}


# ============================================================
# Get alias name
# ============================================================

get_alias_name() {

    local line="$1"

    line="${line#*alias }"
    line="${line%%=*}"

    # Trim leading whitespace
    line="${line#"${line%%[![:space:]]*}"}"

    # Trim trailing whitespace
    line="${line%"${line##*[![:space:]]}"}"

    # Remove optional quotes around alias name
    line="${line#\"}"
    line="${line%\"}"

    line="${line#\'}"
    line="${line%\'}"

    printf '%s\n' "$line"
}


# ============================================================
# Install aliases
#
# Alias lines are copied EXACTLY as they appear.
#
# This allows:
#
#   alias ..="cd .."
#   alias ...="cd ../.."
#
# ============================================================

install_alias_category() {

    local source="$1"

    local name
    local destination
    local temporary
    local line
    local alias_name

    name="$(basename "$source")"
    destination="$ALIAS_DIR/$name"
    temporary="$(mktemp)"

    echo
    echo "------------------------------------------"
    echo " Checking: $name"
    echo "------------------------------------------"

    while IFS= read -r line || [[ -n "$line" ]]; do

        # Blank line
        if [[ -z "$line" ]]; then

            printf '%s\n' "$line" >> "$temporary"

            continue
        fi

        # Comment
        if [[ "$line" =~ ^[[:space:]]*# ]]; then

            printf '%s\n' "$line" >> "$temporary"

            continue
        fi

        # Alias
        if [[ "$line" =~ ^[[:space:]]*alias[[:space:]] ]]; then

            alias_name="$(get_alias_name "$line")"

            if [[ -z "$alias_name" ]]; then

                echo -e \
                    "  ${YELLOW}⚠ Could not determine alias name${NC}"

                continue
            fi

            if alias_has_dependencies "$alias_name"; then

                # Keep the original alias untouched
                printf '%s\n' "$line" >> "$temporary"

                echo -e \
                    "  ${GREEN}✓${NC} $alias_name"

            else

                echo -e \
                    "  ${YELLOW}✗${NC} $alias_name ${YELLOW}(dependency missing)${NC}"

            fi

            continue
        fi

        # Preserve anything else
        printf '%s\n' "$line" >> "$temporary"

    done < "$source"


    if grep -qE '^[[:space:]]*alias[[:space:]]' "$temporary"; then

        if should_overwrite "$destination"; then

            mv "$temporary" "$destination"

            echo
            echo -e "${GREEN}✓ Installed:${NC} $name"

        else

            rm -f "$temporary"

            echo
            echo -e "${YELLOW}Skipped:${NC} $name"

        fi

    else

        rm -f "$temporary"

        echo
        echo -e "${YELLOW}No usable aliases:${NC} $name"

    fi
}


# ============================================================
# Script menu
# ============================================================

script_menu() {

    mapfile -t scripts < <(find_scripts)

    if (( ${#scripts[@]} == 0 )); then

        echo
        echo -e "${YELLOW}No Bash scripts found.${NC}"

        return
    fi

    echo
    echo "=========================================="
    echo " Available Bash Scripts"
    echo "=========================================="
    echo

    local i

    for i in "${!scripts[@]}"; do

        printf "%3d) %s\n" \
            "$((i + 1))" \
            "${scripts[$i]#"$REPO_DIR/"}"

    done

    echo
    echo "Enter numbers separated by spaces."
    echo "Use 'all' for everything or 'q' to go back."
    echo

    ask "Selection: "

    local selection="$REPLY"

    [[ "$selection" == "q" ]] && return

    if [[ "$selection" == "all" ]]; then

        for script in "${scripts[@]}"; do
            install_script "$script"
        done

        ensure_path

        return
    fi

    for number in $selection; do

        if [[ "$number" =~ ^[0-9]+$ ]] &&
           (( number >= 1 && number <= ${#scripts[@]} )); then

            install_script "${scripts[$((number - 1))]}"

        else

            echo "Invalid selection: $number"

        fi

    done

    ensure_path
}


# ============================================================
# Alias menu
# ============================================================

alias_menu() {

    mapfile -t categories < <(find_aliases)

    if (( ${#categories[@]} == 0 )); then

        echo
        echo -e "${YELLOW}No Bash alias categories found.${NC}"
        echo
        echo "Expected:"
        echo "$REPO_DIR/$ALIAS_SUBDIR"
        echo

        return
    fi

    echo
    echo "=========================================="
    echo " Bash Alias Categories"
    echo "=========================================="
    echo

    local i

    for i in "${!categories[@]}"; do

        printf "%3d) %s\n" \
            "$((i + 1))" \
            "$(basename "${categories[$i]}")"

    done

    echo
    echo "Enter numbers separated by spaces."
    echo "Use 'all' for everything or 'q' to go back."
    echo

    ask "Selection: "

    local selection="$REPLY"

    [[ "$selection" == "q" ]] && return

    if [[ "$selection" == "all" ]]; then

        for category in "${categories[@]}"; do
            install_alias_category "$category"
        done

        ensure_alias_loader

        return
    fi

    for number in $selection; do

        if [[ "$number" =~ ^[0-9]+$ ]] &&
           (( number >= 1 && number <= ${#categories[@]} )); then

            install_alias_category \
                "${categories[$((number - 1))]}"

        else

            echo "Invalid selection: $number"

        fi

    done

    ensure_alias_loader
}


# ============================================================
# Install everything
# ============================================================

install_everything() {

    echo
    echo "=========================================="
    echo " Installing Everything"
    echo "=========================================="
    echo

    mapfile -t scripts < <(find_scripts)

    if (( ${#scripts[@]} > 0 )); then

        echo "Bash Scripts:"
        echo

        for script in "${scripts[@]}"; do
            install_script "$script"
        done

    else

        echo "No Bash scripts found."

    fi


    echo
    echo "Alias Categories:"
    echo

    mapfile -t categories < <(find_aliases)

    if (( ${#categories[@]} > 0 )); then

        for category in "${categories[@]}"; do
            install_alias_category "$category"
        done

        ensure_alias_loader

    else

        echo "No alias categories found."

    fi

    ensure_path
}


# ============================================================
# Uninstall
# ============================================================

uninstall_menu() {

    if [[ ! -d "$BIN_DIR" ]]; then

        echo "$BIN_DIR does not exist."
        return
    fi

    mapfile -t files < <(
        find "$BIN_DIR" \
            -maxdepth 1 \
            -type f \
            -printf "%f\n" |
        sort
    )

    if (( ${#files[@]} == 0 )); then

        echo "No scripts found in $BIN_DIR."
        return
    fi

    echo
    echo "=========================================="
    echo " Installed Scripts"
    echo "=========================================="
    echo

    local i

    for i in "${!files[@]}"; do

        printf "%3d) %s\n" \
            "$((i + 1))" \
            "${files[$i]}"

    done

    echo
    echo "Enter numbers separated by spaces."
    echo "Use 'all' to remove everything."
    echo

    ask "Selection: "

    local selection="$REPLY"

    if [[ "$selection" == "all" ]]; then

        for file in "${files[@]}"; do

            rm -f "$BIN_DIR/$file"

            echo "Removed: $file"

        done

        return
    fi

    for number in $selection; do

        if [[ "$number" =~ ^[0-9]+$ ]] &&
           (( number >= 1 && number <= ${#files[@]} )); then

            local file="${files[$((number - 1))]}"

            rm -f "$BIN_DIR/$file"

            echo "Removed: $file"

        else

            echo "Invalid selection: $number"

        fi

    done
}


# ============================================================
# Main menu
# ============================================================

main_menu() {

    while true; do

        clear 2>/dev/null || true

        banner

        echo "Repository:"
        echo "Freaky2112/Scripts"
        echo
        echo "  1) Install Scripts"
        echo "  2) Install Alias Categories"
        echo "  3) Install Everything"
        echo "  4) Uninstall Scripts"
        echo "  5) Exit"
        echo

        ask "Selection: "

        case "$REPLY" in

            1)
                script_menu
                pause
                ;;

            2)
                alias_menu
                pause
                ;;

            3)
                install_everything
                pause
                ;;

            4)
                uninstall_menu
                pause
                ;;

            5)
                echo
                echo "Goodbye!"
                echo
                return
                ;;

            *)
                echo
                echo -e "${YELLOW}Invalid selection.${NC}"
                sleep 1
                ;;

        esac

    done
}


# ============================================================
# Command line
# ============================================================

MODE="menu"

while [[ $# -gt 0 ]]; do

    case "$1" in

        -a|--all)
            MODE="all"
            shift
            ;;

        -s|--scripts)
            MODE="scripts"
            shift
            ;;

        -A|--aliases)
            MODE="aliases"
            shift
            ;;

        -u|--uninstall)
            MODE="uninstall"
            shift
            ;;

        -h|--help)
            usage
            exit 0
            ;;

        *)
            echo "Unknown option: $1"
            usage
            exit 1
            ;;

    esac

done


# ============================================================
# Start
# ============================================================

banner

if [[ "$MODE" != "uninstall" ]]; then

    check_requirements
    download_repository
    prepare_directories

fi


# ============================================================
# Run
# ============================================================

case "$MODE" in

    menu)
        main_menu
        ;;

    scripts)
        script_menu
        pause
        ;;

    aliases)
        alias_menu
        pause
        ;;

    all)
        install_everything
        pause
        ;;

    uninstall)
        uninstall_menu
        pause
        ;;

esac


# ============================================================
# Finish
# ============================================================

echo
echo "=========================================="
echo -e "${GREEN} Done!${NC}"
echo "=========================================="
echo
echo "Scripts : $BIN_DIR"
echo "Aliases : $ALIAS_DIR"
echo

if [[ "$MODE" != "uninstall" ]]; then

    echo "Activate your aliases with:"
    echo
    echo "  source ~/.bashrc"
    echo

fi