#!/bin/bash
CONFIG_FILE="$HOME/.ssh/config"

# Extract aliases, strip Host *, clean whitespace
HOSTS=$(grep -E '^[[:space:]]*Host[[:space:]]+' "$CONFIG_FILE" \
    | sed -E 's/^[[:space:]]*Host[[:space:]]+//' \
    | grep -v '^\*' \
    | tr -d '\r' \
    | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')

HOST_ARRAY=($HOSTS)

# Colors
RED='\033[0;31;43m'
GREEN='\033[1;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
PURPLE='\033[1;35m'
WHITE='\033[0;37m'
RESET='\033[0m'

echo -e "${CYAN}==========================="
echo -e "        SSH Menu"
echo -e "    Choose Your Server"
echo -e "===========================${RESET}"

# Print menu manually (prettier than plain select)
i=1
for h in "${HOST_ARRAY[@]}"; do
    echo -e "${YELLOW}$i)${RESET} ${GREEN}$h${RESET}"
    ((i++))
done
echo -e "${YELLOW}$i)${RESET} ${PURPLE}Quit${RESET}"

read -p "Choose a server: " choice

if [[ $choice -ge 1 && $choice -le ${#HOST_ARRAY[@]} ]]; then
    HOST="${HOST_ARRAY[$((choice-1))]}"
    echo -e "Connecting to ${GREEN}$HOST${RESET}..."
    ssh "$HOST"
elif [[ $choice -eq $i ]]; then
    echo -e "${WHITE}Bye!${RESET}"
else
    echo -e "${RED}>>> Invalid choice. <<<${RESET}"
fi
