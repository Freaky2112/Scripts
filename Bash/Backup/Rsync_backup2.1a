#!/usr/bin/env bash

# Rsync Backup Script: SSH Config, Logging, Dry-Run, Remote->Remote support
# Hosts are included even if they have RemoteCommand / RequestTTY yes,
# but those lines are ignored when parsing the SSH config.

set -euo pipefail

# --- COLOR CODES ---
RED="\033[0;31m"
GREEN="\033[0;32m"
ORANGE="\e[38;5;202m"
YELLOW="\033[1;33m"
BLUE="\e[38;5;21m"
CYAN="\033[0;36m"
ORANGELITE="\e[38;5;214m"
LIME="\e[38;5;106m"
NC="\033[0m" # No Color

# --- FUNCTIONS ---
get_ssh_hosts() {
    # Include all hosts
    grep -E '^Host\s+' ~/.ssh/config 2>/dev/null \
        | awk '{print $2}' \
        | grep -v '[*?]' || true
}

prompt_folder() {
    Local prompt="$1"
    Local folder
    while true; do
        read -rp "$(echo -e "${BLUE}${prompt}${NC}")" folder
        folder=$(echo "$folder" | xargs)
        if [[ -n "$folder" ]]; then
            echo "$folder"
            break
        fi
    done
}

prompt_manual_host() {
    Local host_type="$1"
    echo -e "${CYAN}Enter $host_type connection details:${NC}"
    
    Local user host
    read -rp "$(echo -e "${BLUE}Username (leave empty for current user): ${NC}")" user
    user=$(echo "$user" | xargs)
    
    while true; do
        read -rp "$(echo -e "${BLUE}Hostname or IP: ${NC}")" host
        host=$(echo "$host" | xargs)
        if [[ -n "$host" ]]; then
            break
        fi
        echo -e "${RED}Hostname cannot be empty${NC}"
    done
    
    if [[ -n "$user" ]]; then
        echo "${user}@${host}"
    else
        echo "${host}"
    fi
}

# --- Temporary SSH config generator ---
generate_temp_ssh_config() {
    Local host="$1"
    Local temp_file="$2"

    # Extract Host entry for this host
    awk -v host="$host" '
    BEGIN {in_host=0}
    /^Host[[:space:]]+/ {
        in_host=($2==host)
    }
    in_host {
        # Skip RemoteCommand and RequestTTY yes lines
        if ($1!="RemoteCommand" && !($1=="RequestTTY" && $2=="yes")) print
    }
    ' ~/.ssh/config > "$temp_file"
}

# --- LOAD SSH HOSTS ---
mapfile -t SSH_HOSTS < <(get_ssh_hosts)

echo -e "${CYAN}=== 🧠 Rsync Backup Script ===${NC}"

# --- SELECT SOURCE HOST ---
echo -e "${YELLOW}Select source host:${NC}"
PS3="$(echo -e "${ORANGE}Enter number: ${NC}")"
select SRC_HOST in "Local" "Other (manual entry)" "${SSH_HOSTS[@]}"; do
    if [[ -n "$SRC_HOST" ]]; then
        if [[ "$SRC_HOST" == "Other (manual entry)" ]]; then
            SRC_HOST=$(prompt_manual_host "source")
            SRC_IS_MANUAL=1
        else
            SRC_IS_MANUAL=0
        fi
        break
    fi
done

# --- SELECT DESTINATION HOST ---
echo -e "${YELLOW}Select destination host:${NC}"
PS3="$(echo -e "${ORANGE}Enter number: ${NC}")"
select DEST_HOST in "Local" "Other (manual entry)" "${SSH_HOSTS[@]}"; do
    if [[ -n "$DEST_HOST" ]]; then
        if [[ "$DEST_HOST" == "Other (manual entry)" ]]; then
            DEST_HOST=$(prompt_manual_host "destination")
            DEST_IS_MANUAL=1
        else
            DEST_IS_MANUAL=0
        fi
        break
    fi
done

# --- PROMPT FOR FOLDERS ---
SRC_FOLDER=$(prompt_folder "${ORANGELITE}Folder on '$SRC_HOST' to back up: ")
DEST_FOLDER=$(prompt_folder "${LIME}Folder on '$DEST_HOST' to save backup: ${NC}")

# --- LOG SETUP ---
TIMESTAMP=$(date +"%Y-%m-%d_%H-%M-%S")
LOG_DIR="$HOME/rsync_logs"
LOG_FILE="${LOG_DIR}/backup_${TIMESTAMP}.log"
mkdir -p "$LOG_DIR"

# --- RSYNC OPTIONS ---
EXCLUDES=( "--exclude=.cache" "--exclude=*.tmp" )
RSYNC_OPTS=(-avhzP --delete --itemize-changes "${EXCLUDES[@]}")

# --- TEMP SSH CONFIGS ---
TMP_DIR_CONFIG=$(mktemp -d)
trap 'rm -rf "$TMP_DIR_CONFIG"' EXIT

# Handle SSH config for source
if [[ "$SRC_HOST" != "Local" ]]; then
    if [[ $SRC_IS_MANUAL -eq 1 ]]; then
        # Manual entry: use default SSH settings
        SRC_SSH_CMD=""
    else
        # Config file entry: generate temp config
        SRC_SSH_CONFIG="$TMP_DIR_CONFIG/src_ssh_config"
        generate_temp_ssh_config "$SRC_HOST" "$SRC_SSH_CONFIG"
        SRC_SSH_CMD="-F $SRC_SSH_CONFIG"
    fi
else
    SRC_SSH_CMD=""
fi

# Handle SSH config for destination
if [[ "$DEST_HOST" != "Local" ]]; then
    if [[ $DEST_IS_MANUAL -eq 1 ]]; then
        # Manual entry: use default SSH settings
        DEST_SSH_CMD=""
    else
        # Config file entry: generate temp config
        DEST_SSH_CONFIG="$TMP_DIR_CONFIG/dest_ssh_config"
        generate_temp_ssh_config "$DEST_HOST" "$DEST_SSH_CONFIG"
        DEST_SSH_CMD="-F $DEST_SSH_CONFIG"
    fi
else
    DEST_SSH_CMD=""
fi

# --- DETERMINE PATHS ---
TMP_DIR=""
if [[ "$SRC_HOST" != "Local" && "$DEST_HOST" != "Local" ]]; then
    TMP_DIR="/tmp/rsync_tmp_backup_${TIMESTAMP}"
    mkdir -p "$TMP_DIR"
    echo -e "${YELLOW}⚠️  Both source and destination are remote. Using temporary Local folder: ${TMP_DIR}${NC}"

    SRC_PATH="${SRC_HOST}:${SRC_FOLDER%/}"
    DEST_PATH="$TMP_DIR"
    SECOND_STEP_DEST="${DEST_HOST}:${DEST_FOLDER%/}"
else
    SRC_PATH=$([[ "$SRC_HOST" == "Local" ]] && echo "${SRC_FOLDER%/}" || echo "${SRC_HOST}:${SRC_FOLDER%/}")
    DEST_PATH=$([[ "$DEST_HOST" == "Local" ]] && echo "${DEST_FOLDER%/}" || echo "${DEST_HOST}:${DEST_FOLDER%/}")
fi

# --- DISPLAY CONFIGURATION ---
echo -e "${CYAN}⚙️  Backup Configuration:${NC}"
echo -e "Source:      ${BLUE}${SRC_PATH}${NC}"
echo -e "Destination: ${BLUE}${DEST_PATH}${NC}"
echo -e "Log File:    ${BLUE}${LOG_FILE}${NC}"
echo

# --- DRY-RUN ---
echo -e "${CYAN}🧪 Performing dry-run (simulation only)...${NC}"

if [[ -n "$TMP_DIR" ]]; then
    DRY_CMD1=("rsync" --dry-run -e "ssh $SRC_SSH_CMD" "${RSYNC_OPTS[@]}" -- "${SRC_PATH}/" "${DEST_PATH}/")
    DRY_CMD2=("rsync" --dry-run -e "ssh $DEST_SSH_CMD" "${RSYNC_OPTS[@]}" -- "${DEST_PATH}/" "${SECOND_STEP_DEST}/")

    echo -e "${YELLOW}Dry-run command (Step 1: fetch from source to Local temp):${NC}"
    printf '  %q ' "${DRY_CMD1[@]}"; echo
    echo -e "${YELLOW}Dry-run command (Step 2: push from Local temp to destination):${NC}"
    printf '  %q ' "${DRY_CMD2[@]}"; echo

    {
        echo "===== RSYNC DRY-RUN STARTED: ${TIMESTAMP} ====="
        "${DRY_CMD1[@]}"
        "${DRY_CMD2[@]}"
        echo "===== RSYNC DRY-RUN ENDED: $(date) ====="
    } | tee -a "$LOG_FILE"

else
    DRY_CMD=("rsync" --dry-run -e "ssh $SRC_SSH_CMD" "${RSYNC_OPTS[@]}" -- "${SRC_PATH}/" "${DEST_PATH}/")
    echo -e "${YELLOW}Dry-run command:${NC}"
    printf '  %q ' "${DRY_CMD[@]}"; echo

    {
        echo "===== RSYNC DRY-RUN STARTED: ${TIMESTAMP} ====="
        "${DRY_CMD[@]}"
        echo "===== RSYNC DRY-RUN ENDED: $(date) ====="
    } | tee -a "$LOG_FILE"
fi

# --- CONFIRM REAL BACKUP ---
echo
read -rp "$(echo -e "${BLUE}Do you want to perform the REAL backup now? (y/n): ${NC}")" CONFIRM
if [[ ! "$CONFIRM" =~ ^[Yy]$ ]]; then
    echo -e "${RED}🚫 Backup cancelled.${NC} Log saved to: ${LOG_FILE}"
    exit 0
fi

# --- PERFORM REAL BACKUP ---
echo -e "${CYAN}🚀 Starting real backup...${NC}"
if [[ -n "$TMP_DIR" ]]; then
    echo -e "${YELLOW}Step 1: Fetching from $SRC_HOST to temporary Local folder...${NC}"
    rsync -e "ssh $SRC_SSH_CMD" "${RSYNC_OPTS[@]}" -- "${SRC_PATH}/" "${DEST_PATH}/"
    STATUS1=$?

    echo -e "${YELLOW}Step 2: Sending from temporary Local folder to $DEST_HOST...${NC}"
    rsync -e "ssh $DEST_SSH_CMD" "${RSYNC_OPTS[@]}" -- "${DEST_PATH}/" "${SECOND_STEP_DEST}/"
    STATUS2=$?

    rm -rf "$TMP_DIR"
    STATUS=$((STATUS1 + STATUS2))
else
    rsync -e "ssh $SRC_SSH_CMD" "${RSYNC_OPTS[@]}" -- "${SRC_PATH}/" "${DEST_PATH}/"
    STATUS=$?
fi

echo -e "${CYAN}===== RSYNC BACKUP FINISHED: $(date) =====${NC}" | tee -a "$LOG_FILE"
if [ ${STATUS:-1} -eq 0 ]; then
    echo -e "${GREEN}✅ Backup completed successfully.${NC} Log saved to: $LOG_FILE"
else
    echo -e "${RED}❌ Rsync encountered an error.${NC} Check log: $LOG_FILE"
    exit 1
fi