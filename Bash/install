```bash
#!/usr/bin/env bash
#
# Author: Freaky
# Contributor: ChatGPT, Claude
#
# Description:
# Installer for My HomeLab scripts and Bash aliases.
#
# Scripts are installed into:
#   ~/.local/bin
#
# Bash aliases are installed into:
#   ~/.bash_aliases.d
#
# Aliases are checked individually for required dependencies.
# If a dependency is missing, only the affected alias is skipped.
#

set -euo pipefail
IFS=$'\n\t'

BIN_DIR="$HOME/.local/bin"
ALIAS_DIR="$HOME/.bash_aliases.d"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ALIAS_SOURCE_DIR="$SCRIPT_DIR/aliases"

SHELL_RC_FILES=(
    "$HOME/.bashrc"
    "$HOME/.profile"
    "$HOME/.zshrc"
)

SKIP_ALL_OVERWRITE=false


usage() {
    cat <<EOF

⚡ My HomeLab Installer

Usage:
  $0 [options]

Options:
  -a, --all          Install all scripts and all alias sections
  -i, --interactive  Interactive installation menu (default)
  -l, --aliases      Interactive alias section installer
  -u, --uninstall    Uninstall selected scripts from ~/.local/bin
  -h, --help         Show this help

Examples:

  $0
      Interactive installer

  $0 --interactive
      Interactive installer

  $0 --aliases
      Install Bash alias sections

  $0 --all
      Install all scripts and aliases

Installed locations:

  Scripts:
      $BIN_DIR

  Bash aliases:
      $ALIAS_DIR

EOF
}


# ------------------------------------------------------------
# Prepare directories
# ------------------------------------------------------------

prepare_dirs() {

    if [[ ! -d "$BIN_DIR" ]]; then
        mkdir -p "$BIN_DIR"
        echo "Created $BIN_DIR"
    fi

    if [[ ! -d "$ALIAS_DIR" ]]; then
        mkdir -p "$ALIAS_DIR"
        echo "Created $ALIAS_DIR"
    fi
}


# ------------------------------------------------------------
# PATH
# ------------------------------------------------------------

ensure_path() {

    if [[ ":$PATH:" != *":$BIN_DIR:"* ]]; then

        if ! grep -qF '# Added by bin-installer' "$HOME/.profile" 2>/dev/null; then

            printf '\n# Added by bin-installer: ensure ~/.local/bin is in PATH\n' \
                >> "$HOME/.profile"

            printf 'export PATH="%s:$PATH"\n' "$BIN_DIR" \
                >> "$HOME/.profile"

            echo "Added $BIN_DIR to PATH in ~/.profile"
        fi
    fi

    for rc in "${SHELL_RC_FILES[@]}"; do

        if [[ -f "$rc" ]]; then

            if ! grep -qF "$BIN_DIR" "$rc" 2>/dev/null; then

                printf '\n# Added by bin-installer: ensure ~/.local/bin is in PATH\n' \
                    >> "$rc"

                printf 'export PATH="%s:$PATH"\n' "$BIN_DIR" \
                    >> "$rc"

                echo "Added PATH export to $rc"
            fi
        fi
    done
}


# ------------------------------------------------------------
# Alias loader
# ------------------------------------------------------------

ensure_alias_loader() {

    local bashrc="$HOME/.bashrc"

    touch "$bashrc"

    if grep -qF "# My HomeLab Bash Aliases" "$bashrc"; then
        return 0
    fi

    cat >> "$bashrc" <<'EOF'

# My HomeLab Bash Aliases
if [ -d "$HOME/.bash_aliases.d" ]; then
    for alias_file in "$HOME/.bash_aliases.d"/*.bash; do
        [ -r "$alias_file" ] && source "$alias_file"
    done
fi
EOF

    echo "Added My HomeLab alias loader to ~/.bashrc"
}


# ------------------------------------------------------------
# Dependency checking
# ------------------------------------------------------------

command_exists() {

    command -v "$1" >/dev/null 2>&1
}


check_dependency() {

    local dependency="$1"

    if command_exists "$dependency"; then
        return 0
    fi

    return 1
}


# ------------------------------------------------------------
# Alias dependency map
#
# Format:
#   alias name -> required command
#
# Aliases not listed here are considered dependency-free.
# ------------------------------------------------------------

declare -A ALIAS_DEPENDENCY=(

    # Network
    [wip]="curl"
    [wt]="curl"
    [speed]="curl"
    [ports]="ss"
    [conns]="ss"
    [openports]="ss"
    [established]="ss"
    [dns]="dig"
    [digg]="dig"
    [trace]="traceroute"
    [headers]="curl"

    # System
    [mem]="free"
    [top]="htop"
    [dmesg]="dmesg"
    [pci]="lspci"
    [usb]="lsusb"

    # SSH
    [sshlist]="ssh-add"
    [ssha]="ssh-agent"
    [sshconfig]="nano"

    # Storage
    [df]="df"
    [disk]="df"
    [disks]="lsblk"
    [du]="du"
    [bigfiles]="du"

    # Docker
    [dps]="docker"
    [dpsa]="docker"
    [dimg]="docker"
    [dlog]="docker"
    [dstats]="docker"
    [dtop]="docker"
    [dstart]="docker"
    [dstop]="docker"
    [drestart]="docker"
    [drm]="docker"
    [dockerdu]="docker"
    [dclean]="docker"

    # Docker Compose
    [dcup]="docker"
    [dcdown]="docker"
    [dcrestart]="docker"
    [dcps]="docker"
    [dclog]="docker"
    [dcpull]="docker"
    [dcupdate]="docker"
    [dcrebuild]="docker"

    # Logs
    [logs]="journalctl"
    [sjournal]="journalctl"
    [todaylogs]="journalctl"
    [bootlogs]="journalctl"
    [klogs]="journalctl"
    [errors]="journalctl"

    # Systemd
    [services]="systemctl"
    [failed]="systemctl"
    [sstatus]="systemctl"
    [srestart]="systemctl"
    [sstart]="systemctl"
    [sstop]="systemctl"
    [senable]="systemctl"
    [sdisable]="systemctl"

    # Tools
    [mounts]="mount"
    [aliases]="nano"
    [ccat]="batcat"
)


# ------------------------------------------------------------
# Check dependencies for alias
# ------------------------------------------------------------

check_alias_dependency() {

    local alias_name="$1"

    # No dependency defined
    if [[ -z "${ALIAS_DEPENDENCY[$alias_name]+x}" ]]; then
        return 0
    fi

    local dependency="${ALIAS_DEPENDENCY[$alias_name]}"

    if check_dependency "$dependency"; then
        return 0
    fi

    return 1
}


# ------------------------------------------------------------
# Extract alias name
# ------------------------------------------------------------

get_alias_name() {

    local line="$1"

    if [[ "$line" =~ ^[[:space:]]*alias[[:space:]]+([a-zA-Z0-9_.-]+)= ]]; then
        echo "${BASH_REMATCH[1]}"
    fi
}


# ------------------------------------------------------------
# Install alias section
# ------------------------------------------------------------

install_alias_section() {

    local source="$1"
    local section
    local destination
    local alias_name
    local dependency

    section="$(basename "$source")"
    destination="$ALIAS_DIR/$section"

    echo
    echo "⚡ Installing alias section: $section"

    : > "$destination"

    while IFS= read -r line || [[ -n "$line" ]]; do

        # Comments and blank lines are always copied
        if [[ "$line" =~ ^[[:space:]]*# ]] ||
           [[ -z "${line//[[:space:]]/}" ]]; then

            echo "$line" >> "$destination"
            continue
        fi

        alias_name="$(get_alias_name "$line")"

        # Not an alias - copy it
        if [[ -z "$alias_name" ]]; then
            echo "$line" >> "$destination"
            continue
        fi

        # Check dependency
        if check_alias_dependency "$alias_name"; then

            echo "$line" >> "$destination"
            echo "  ✓ $alias_name"

        else

            dependency="${ALIAS_DEPENDENCY[$alias_name]}"

            echo "  ✗ $alias_name"
            echo "    Missing dependency: $dependency"
            echo "    Skipping alias"

        fi

    done < "$source"

    # Remove empty alias files
    if ! grep -qE '^[[:space:]]*alias[[:space:]]+' "$destination"; then

        rm -f "$destination"

        echo "  No usable aliases found."
        return 1
    fi

    echo "Installed: $destination"

    ensure_alias_loader
}


# ------------------------------------------------------------
# Find alias sections
# ------------------------------------------------------------

list_alias_sections() {

    if [[ ! -d "$ALIAS_SOURCE_DIR" ]]; then
        return 0
    fi

    find "$ALIAS_SOURCE_DIR" \
        -maxdepth 1 \
        -type f \
        -name "*.bash" \
        -printf "%f\n" \
        2>/dev/null |
        sort
}


# ------------------------------------------------------------
# Interactive alias installer
# ------------------------------------------------------------

interactive_alias_install() {

    mapfile -t sections < <(list_alias_sections)

    if [[ ${#sections[@]} -eq 0 ]]; then

        echo "No alias sections found in:"
        echo "  $ALIAS_SOURCE_DIR"

        return 1
    fi

    echo
    echo "⚡ My HomeLab Bash Aliases"
    echo
    echo "Available sections:"
    echo

    for i in "${!sections[@]}"; do
        printf "%3d) %s\n" \
            $((i + 1)) \
            "${sections[$i]}"
    done

    echo
    echo "Enter numbers separated by spaces."
    echo "Enter 'all' to install every section."
    echo "Enter 'q' to quit."
    echo

    read -rp "Selection: " selection

    if [[ "$selection" == "q" ]]; then
        echo "Aborted."
        return 0
    fi

    if [[ "$selection" == "all" ]]; then

        for section in "${sections[@]}"; do
            install_alias_section "$ALIAS_SOURCE_DIR/$section"
        done

        return 0
    fi

    for token in $selection; do

        if [[ "$token" =~ ^[0-9]+$ ]] &&
           (( token >= 1 && token <= ${#sections[@]} )); then

            section="${sections[$((token - 1))]}"

            install_alias_section \
                "$ALIAS_SOURCE_DIR/$section"

        else

            echo "Skipping invalid selection: $token"

        fi

    done
}


# ------------------------------------------------------------
# Install all aliases
# ------------------------------------------------------------

install_all_aliases() {

    mapfile -t sections < <(list_alias_sections)

    for section in "${sections[@]}"; do
        install_alias_section "$ALIAS_SOURCE_DIR/$section"
    done
}


# ------------------------------------------------------------
# Existing script discovery
# ------------------------------------------------------------

list_candidates() {

    find . -type f \
        \( -name "*.sh" -o -perm -111 -o -exec grep -Iq "^#!" {} \; -print \) \
        -printf "%P\n" 2>/dev/null |
        sed '/^\./d' |
        grep -vE '(^|/)install(\.sh)?$' |
        grep -vE '(^|/)bin-installer\.sh$' |
        grep -vE '^aliases/' |
        sort -u
}


# ------------------------------------------------------------
# Overwrite prompt
# ------------------------------------------------------------

prompt_overwrite() {

    local target="$1"

    if [[ -e "$target" ]]; then

        while true; do

            read -rp \
                "$target exists — overwrite? [y]es/[n]o/[s]kip-all: " \
                yn

            case "$yn" in

                [Yy]*)
                    return 0
                    ;;

                [Nn]*)
                    return 1
                    ;;

                [Ss]*)
                    echo SKIP_ALL
                    return 2
                    ;;

                *)
                    echo "Please answer y, n, or s."
                    ;;

            esac

        done
    fi

    return 0
}


# ------------------------------------------------------------
# Install normal script
# ------------------------------------------------------------

install_file() {

    local src="$1"
    local dest="$BIN_DIR/$(basename "$src")"

    if [[ "$SKIP_ALL_OVERWRITE" == "true" ]]; then

        echo "Skipping $src"
        return

    fi

    if [[ -e "$dest" ]]; then

        prompt_overwrite "$dest"

        case $? in

            0)
                ;;

            1)
                echo "Skipping $src"
                return
                ;;

            2)
                SKIP_ALL_OVERWRITE=true
                echo "Skipping $src"
                return
                ;;

        esac

    fi

    cp -p "$src" "$dest"
    chmod +x "$dest"

    echo "Installed: $dest"
}


# ------------------------------------------------------------
# Interactive normal script installation
# ------------------------------------------------------------

interactive_install() {

    mapfile -t candidates < <(list_candidates)

    if [[ ${#candidates[@]} -eq 0 ]]; then

        echo "No candidate scripts found."

        return 1
    fi

    echo
    echo "Available scripts:"
    echo

    for i in "${!candidates[@]}"; do

        printf "%3d) %s\n" \
            $((i + 1)) \
            "${candidates[$i]}"

    done

    echo
    echo "Enter numbers separated by spaces."
    echo "'all' installs all scripts."
    echo "'q' quits."
    echo

    read -rp "Selection: " selection

    if [[ "$selection" == "q" ]]; then
        echo "Aborted."
        return 0
    fi

    if [[ "$selection" == "all" ]]; then

        for f in "${candidates[@]}"; do
            install_file "$f"
        done

        return 0
    fi

    for token in $selection; do

        if [[ "$token" =~ ^[0-9]+$ ]] &&
           (( token >= 1 && token <= ${#candidates[@]} )); then

            f="${candidates[$((token - 1))]}"

            install_file "$f"

        else

            echo "Skipping invalid selection: $token"

        fi

    done
}


# ------------------------------------------------------------
# Install all scripts
# ------------------------------------------------------------

install_all() {

    mapfile -t candidates < <(list_candidates)

    for f in "${candidates[@]}"; do
        install_file "$f"
    done
}


# ------------------------------------------------------------
# Uninstall
# ------------------------------------------------------------

uninstall_menu() {

    if [[ ! -d "$BIN_DIR" ]]; then

        echo "$BIN_DIR does not exist."
        echo "Nothing to uninstall."

        return 0
    fi

    mapfile -t files < <(
        find "$BIN_DIR" \
            -maxdepth 1 \
            -type f \
            -printf "%f\n" |
        sort
    )

    if [[ ${#files[@]} -eq 0 ]]; then

        echo "No files found in $BIN_DIR"

        return 0
    fi

    echo
    echo "Select files to uninstall:"
    echo

    for i in "${!files[@]}"; do

        printf "%3d) %s\n" \
            $((i + 1)) \
            "${files[$i]}"

    done

    echo
    read -rp "Selection: " selection

    if [[ "$selection" == "all" ]]; then

        for f in "${files[@]}"; do

            rm -f "$BIN_DIR/$f"

            echo "Removed: $BIN_DIR/$f"

        done

        return 0
    fi

    for token in $selection; do

        if [[ "$token" =~ ^[0-9]+$ ]] &&
           (( token >= 1 && token <= ${#files[@]} )); then

            f="${files[$((token - 1))]}"

            rm -f "$BIN_DIR/$f"

            echo "Removed: $BIN_DIR/$f"

        else

            echo "Skipping invalid selection: $token"

        fi

    done
}


# ------------------------------------------------------------
# Main
# ------------------------------------------------------------

if [[ $# -eq 0 ]]; then

    MODE="interactive"

else

    MODE=""

    while [[ $# -gt 0 ]]; do

        case "$1" in

            -a|--all)
                MODE="all"
                shift
                ;;

            -i|--interactive)
                MODE="interactive"
                shift
                ;;

            -l|--aliases)
                MODE="aliases"
                shift
                ;;

            -u|--uninstall)
                MODE="uninstall"
                shift
                ;;

            -h|--help)
                usage
                exit 0
                ;;

            *)
                echo "Unknown argument: $1"
                usage
                exit 1
                ;;

        esac

    done

fi


prepare_dirs


case "$MODE" in

    interactive)

        interactive_install
        interactive_alias_install
        ensure_path

        ;;

    aliases)

        interactive_alias_install

        ;;

    all)

        install_all
        install_all_aliases
        ensure_path

        ;;

    uninstall)

        uninstall_menu

        ;;

    *)

        echo "Unknown mode: $MODE"
        usage
        exit 1

        ;;

esac


echo
echo "⚡ My HomeLab installation complete."
echo
echo "Scripts:"
echo "  $BIN_DIR"
echo
echo "Aliases:"
echo "  $ALIAS_DIR"
echo
echo "Reload your shell:"
echo "  source ~/.bashrc"
echo
```